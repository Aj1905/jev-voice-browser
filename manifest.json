{
  "manifest_version": 3,
  "name": "Jev Voice Browser",
  "version": "0.1.0",
  "description": "音声でブラウザを操作する。指示の解釈は TypeSafe の Jev が担当。",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "search"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Jev Voice Browser"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-listening": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "Alt+Shift+V"
      },
      "description": "音声入力の開始 / 停止"
    }
  }
}